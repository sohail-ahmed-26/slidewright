# ---------- Database (local Postgres via docker-compose) ----------
DATABASE_URL="postgresql://slidewright:slidewright@localhost:5432/slidewright?schema=public"

# ---------- Servers ----------
BACKEND_PORT=4000
FRONTEND_PORT=5173
# Folder where generated files are saved (images, pptx, screenshots, logs)
OUTPUTS_DIR=./outputs

# ---------- ONE API for everything: OpenRouter ----------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Check exact model ids on https://openrouter.ai/models (filter: structured_outputs / image output)
MODEL_TEXT=
MODEL_VISION=
MODEL_IMAGE=
# true = fake responses from fixtures (works without any API key)
USE_MOCK_LLM=true
